---
const {
  href = "#",
  variant = "primary",
  label,
} = Astro.props as { href?: string; variant?: "primary" | "secondary" | "ghost"; label: string };
---

<a class:list={["button", `button--${variant}`]} href={href}>
  <span>{label}</span>
  <span class="button__arrow" aria-hidden="true">-&gt;</span>
</a>

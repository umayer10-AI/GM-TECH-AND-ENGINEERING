---
import Button from "@/components/ui/Button.astro";
import { imageLibrary } from "@/data/site";
---

<section class="cta" aria-label="Request a quote">
  <img
    src={imageLibrary.cta}
    alt="Premium swimming pool environment for GM TECH & ENGINEERING construction and maintenance services"
    width="1800"
    height="1200"
    loading="lazy"
    decoding="async"
  />
  <div class="cta__overlay"></div>
  <div class="container cta__content" data-reveal>
    <p class="eyebrow">Start a project</p>
    <h2>Need Help With Your Swimming Pool?</h2>
    <p>Whether you need construction, repair, maintenance, renovation, equipment installation or water feature solutions, talk to GM TECH & ENGINEERING.</p>
    <div>
      <Button href="/contact#contact-form" label="Request a Quote" />
      <Button href="/contact" label="Contact Us" variant="secondary" />
    </div>
  </div>
</section>
